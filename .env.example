# Copy to .env for local settings. .env is git-ignored and never published.

# Country for news headlines (US, IN, GB, ...)
NEWS_COUNTRY=US

# Optional local AI (Ollama). Leave unset to use the built-in brain.
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_HOST=http://127.0.0.1:11434

# Force the built-in brain even if Ollama is running
# BRAIN=rules

# PORT=5050
